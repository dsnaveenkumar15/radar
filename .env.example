# Shared by web and batch. Copy to .env. Radar serves only RADAR_HOST; the other hosts are used for footer links.
TRUST_HOST=trust.naveenlabs.tech
RADAR_HOST=radar.naveenlabs.tech
BLUEPRINTS_HOST=blueprints.naveenlabs.tech
PUBLIC_SCHEME=https
PUBLIC_PORT=
ADMIN_USER=owner
# 16+ characters; /admin is disabled (404) while this is the default or shorter.
ADMIN_PASSWORD=change-me
PLANET_MODULES=radar.jobs
RADAR_MODEL=sonnet
WEIGHTS=radar=100
KUMA_PUSH_URL=
# Upgrade agent (/agent). Off unless AGENT_ENABLED=1 with a key and at least one model. Models are OpenRouter ids, primary first.
# AGENT_PRICES (USD per million tokens, `model=in/out;...`) is only used when the provider reports no cost; unlisted models are
# charged a conservative default. GITHUB_TOKEN is the same read-only token as batch.env (the web app fetches repos itself).
AGENT_ENABLED=0
OPENROUTER_API_KEY=
AGENT_FAST_MODELS=
AGENT_STRONG_MODELS=
# Optional: models that may keep prompts (free tiers). Used first, and only, for PUBLIC repository runs; never for pasted files.
AGENT_PUBLIC_MODELS=
AGENT_PRICES=
AGENT_DAILY_USD=1.0
GITHUB_TOKEN=
# Console control interface and batch model use (the private ops console). CONTROL_TOKEN is one long random value, the same
# in every app and in the console; with it unset the interface does not exist. Batch jobs use OpenRouter (BATCH_MODEL) under a
# daily dollar cap when OPENROUTER_API_KEY and BATCH_MODEL are set, else the Claude CLI.
CONTROL_TOKEN=
BATCH_MODEL=deepseek/deepseek-v4.1-flash
BATCH_DAILY_USD=0.03
